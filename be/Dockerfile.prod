# Backend Production Dockerfile
FROM node:22-alpine AS builder

# Install pnpm
RUN npm install -g pnpm@9.12.0

# mediasoup 빌드를 위한 필수 도구 설치
RUN apk add --no-cache python3 py3-pip make g++ gcc linux-headers

# Set working directory
WORKDIR /app

# Copy workspace manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY be/package.json ./be/

# Install dependencies for backend workspace
# --ignore-scripts 항목 삭제: mediasoup post install 스크립트 실행이 막힘
RUN pnpm install --frozen-lockfile

# Copy source code
COPY be ./be

# Build application
WORKDIR /app/be
RUN pnpm build

# Production stage
FROM node:22-alpine AS production

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@9.12.0

# 수정사항: 빌드 단계에서 이미 완성된 node_modules와 dist를 통째로 복사
# install 과정이 불필요해짐
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/be/node_modules ./be/node_modules
COPY --from=builder /app/be/dist ./be/dist

# 설정 및 환경 파일 복사
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY be/package.json ./be/
COPY be/.env.production ./be/.env.production

# Set environment variables
ARG NODE_ENV=production
ARG VERSION=latest
ENV NODE_ENV=${NODE_ENV}
ENV VERSION=${VERSION}

# Expose port
EXPOSE 4000

# Start application
WORKDIR /app/be
CMD ["sh", "-c", "pnpm migration:run:prod && node dist/main.js"]
